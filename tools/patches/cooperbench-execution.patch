+        result = sb.exec("bash", "-c", f": > {target}")
+        if result.returncode != 0:
+            raise RuntimeError(f"Failed to write {filename}: {result.stderr_read()}")
+        return
+
+    # A single bash -c argument containing a large base64 patch can exceed
+    # Linux MAX_ARG_STRLEN even when the overall command-line limit is higher.
+    # Chunk on a base64 quantum boundary so each exec argument stays bounded.
+    for offset in range(0, len(encoded), 65536):
+        chunk = encoded[offset : offset + 65536]
+        redirect = ">" if offset == 0 else ">>"
+        result = sb.exec(
+            "bash", "-c", f"printf '%s' '{chunk}' | base64 -d {redirect} {target}"
+        )
+        if result.returncode != 0:
+            raise RuntimeError(f"Failed to write {filename}: {result.stderr_read()}")
 
 
