      "number": 1,
      "public_cases": [
        {
          "body": "\nimport hashlib\nfrom blobstore.objects import ObjectStore\ns=ObjectStore(ROOT); data=b'hello\\x00world'; oid=s.put_bytes(data)\nassert oid==hashlib.sha256(data).hexdigest() and s.get(oid)==data and s.verify(oid)\n",
          "name": "digest_and_roundtrip"
        },
        {
          "body": "\nfrom blobstore.objects import ObjectStore\ns=ObjectStore(ROOT); oid=s.put_bytes(b'x'); p=s.path_for(oid)\nassert p.parent.name==oid[:2] and p.name==oid[2:] and p.is_file()\n",
          "name": "sharded_path"
        }
      ]
