          "body": "\nfrom blobstore.objects import ObjectStore\nfrom blobstore.replicas import ReplicaSet\np=ObjectStore(ROOT/'p'); a=ObjectStore(ROOT/'a'); b=ObjectStore(ROOT/'b'); oid=p.put_bytes(b'x'); a.put_bytes(b'x'); b.put_bytes(b'x'); b.path_for(oid).write_bytes(b'bad')\nr=ReplicaSet(p,[a,b]).audit(oid); assert r.states==('healthy','healthy','corrupt')\n",
