# Copy this file to .env and fill only the values needed by your command.
# Never commit .env or real credentials.

# Required for formal OpenAI-compatible cells; not used by check-env core or mock smoke.
OPENAI_API_KEY=

# Optional OpenAI-compatible routing. Leave blank for the official endpoint.
OPENAI_BASE_URL=
RELIC_OPENAI_DEFAULT_HEADERS_JSON={}
RELIC_OPENAI_DISABLE_RESPONSE_STORAGE=true

# Required for formal cell evaluation. The evaluator image is not yet published;
# keep the image blank until an immutable digest is supplied by the authors.
RELIC_EVALUATOR_BACKEND=docker
RELIC_EVALUATOR_CONTAINER_IMAGE=
RELIC_EVALUATOR_CONTAINER_PLATFORM=linux/amd64
ORG_OSS_QUALIFICATION_TIMEOUT=180

# Optional path overrides. Linux/WSL paths are required for the formal runtime.
RELIC_OUTPUT_ROOT=
RELIC_BENCHMARK_ROOT=
RELIC_CACHE_ROOT=
RELIC_INSPECTOR_PORT=8765

# Docker Compose runs as this host UID/GID so bind-mounted outputs remain
# owned by the invoking user. Change these if `id -u` / `id -g` are not 1000.
RELIC_UID=1000
RELIC_GID=1000

# Filename inside the read-only ./traces mount used by the Inspector service.
# The release intentionally does not bundle a selected paper trace.
RELIC_TRACE_FILE=selected-trace.json

# Required for the formal Claude arm when the configured OpenAI-compatible
# gateway uses a deployed model alias different from the paper label.
RELIC_CLAUDE_OPUS_4_6_MODEL=
